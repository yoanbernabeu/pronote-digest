# Enfants et flux iCal Pronote (JSON). Le jeton est dans l'URL : ne jamais committer ce fichier rempli.
CHILDREN='[{"name":"Alice","ics":"https://0000000x.index-education.net/pronote/ical/Edt_x.ics?icalsecurise=…&version=…&param=…"}]'

# Canaux actifs, séparés par des virgules : email, file
CHANNELS=email
SUBJECT_PREFIX=[Pronote]

# Archive (JSON + rendus), un dossier par date visée. `none` pour désactiver.
ARCHIVE_DIR=archive
# Jour sans cours : notify (message court) ou skip
ON_NO_SCHOOL=notify
# Échouer si aucun flux ne contient de cahier de textes (digest homework)
REQUIRE_HOMEWORK_DATA=true

# Canal email : n'importe quel fournisseur SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Pronote Digest <digest@example.com>
MAIL_TO=parent1@example.com,parent2@example.com

# Canal file
FILE_DIR=out

# Introduction rédigée par IA (optionnel). Laisser AI_PROVIDER vide pour désactiver.
# Fournisseurs : anthropic, openai, mistral, google, ollama, openai-compatible
AI_PROVIDER=
AI_MODEL=claude-opus-5
AI_API_KEY=
# Pour ollama (http://localhost:11434/v1) ou un endpoint compatible OpenAI
AI_BASE_URL=
# Digests concernés par l'intro : planning, homework
AI_DIGESTS=planning
